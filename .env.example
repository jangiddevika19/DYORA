# ==========================================================
# DYORA — Environment Configuration
# Copy this file to `.env` (backend) and never commit real secrets.
# ==========================================================

# ---- AI Provider (OpenAI-compatible) ----
# Works with OpenAI, Azure OpenAI, OpenRouter, Groq, Together,
# or any self-hosted gateway exposing /chat/completions.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai-compatible

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/dyora?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- Security ----
# Generate a long random string (32+ chars) for production.
JWT_SECRET=change-this-super-secret-key-in-production-min-256-bits-long
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173

# ---- File uploads ----
MAX_FILE_SIZE=15MB
MAX_FILE_SIZE_MB=15

# ---- Server ----
SERVER_PORT=8080
